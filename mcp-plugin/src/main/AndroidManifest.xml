<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/mcp_plugin_label">

        <!--  宿主据此找到插件入口类  -->
        <meta-data
            android:name="org.autojs.plugin.sdk.registry"
            android:value="org.autojs.autoxjs.mcp.McpPluginRegistry" />
        <meta-data
            android:name="org.autojs.plugin.sdk.description"
            android:value="@string/mcp_plugin_description" />

        <!--  同时作为插件的枚举入口与设置界面  -->
        <activity
            android:name=".McpSettingsActivity"
            android:exported="true"
            android:label="@string/mcp_plugin_label"
            android:theme="@style/Theme.AppCompat.DayNight">
            <intent-filter>
                <action android:name="org.autojs.plugin.sdk.PLUGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
