<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/mcp_plugin_label">

        <!--  宿主据此找到插件入口类  -->
        <meta-data
            android:name="org.autojs.plugin.sdk.registry"
            android:value="org.autojs.autoxjs.mcp.McpPluginRegistry" />
        <meta-data
            android:name="org.autojs.plugin.sdk.description"
            android:value="@string/mcp_plugin_description" />

        <!--
            插件不提供任何界面：设置页由宿主按插件声明的配置 schema 渲染。
            本组件只作为枚举标记（无 UI、不导出、无启动图标），
            宿主通过 org.autojs.plugin.sdk.PLUGIN action 发现本插件。
        -->
        <activity
            android:name=".McpPluginMarkerActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="org.autojs.plugin.sdk.PLUGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
