<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/mcp_settings_category_server">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="key_mcp_enabled"
            android:summary="@string/mcp_settings_enable_summary"
            android:title="@string/mcp_settings_enable_title" />

        <EditTextPreference
            android:defaultValue="0.0.0.0"
            android:dialogMessage="@string/mcp_settings_host_summary"
            android:key="key_mcp_host"
            android:summary="@string/mcp_settings_host_summary"
            android:title="@string/mcp_settings_host_title" />

        <EditTextPreference
            android:defaultValue="27190"
            android:key="key_mcp_port"
            android:summary="%s"
            android:title="@string/mcp_settings_port_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/mcp_settings_category_security">

        <EditTextPreference
            android:key="key_mcp_token"
            android:summary="@string/mcp_settings_token_summary"
            android:title="@string/mcp_settings_token_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="key_mcp_allow_base64"
            android:summary="@string/mcp_settings_allow_base64_summary"
            android:title="@string/mcp_settings_allow_base64_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="key_mcp_allow_network"
            android:summary="@string/mcp_settings_allow_network_summary"
            android:title="@string/mcp_settings_allow_network_title" />
    </PreferenceCategory>

</PreferenceScreen>
